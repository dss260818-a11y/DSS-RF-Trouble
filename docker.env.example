# 도커 컨테이너에 넣는 비밀값. docker.env 로 복사해 채우세요. (docker.env 는 저장소에 올라가지 않습니다)
#
#   copy docker.env.example docker.env
#
# PC 에서 그냥 실행할 때 쓰는 .env 와는 별개입니다.

# ── 통합 로그인(DSS 포털) ───────────────────────────────────────────────────
# 🔴 들어오는 길은 이것 하나입니다. 팀 공용 비밀번호(TEAM_PASSWORD)로 들어오던
#    길은 2026-10-21 에 코드에서 걷어냈습니다 — 여기 적어도 아무 일도 일어나지
#    않고, 포털이 멈추면 아무도 못 들어옵니다(까닭은 tools/auth.js 머리말).
#
# 네 값이 모두 채워져야 켜집니다. 하나라도 비면 꺼진 채로 돌아가고,
# 서버를 켤 때 빠진 이름을 알려 줍니다. 꺼진 채로는 컨테이너가 외부 접속을
# 받지 않습니다(사내망에 로그인 없이 열리는 일을 막는 안전장치).
#
# SSO_ISSUER        포털 주소. 끝에 빗금(/)을 붙이지 마세요.
# SSO_CLIENT_ID     포털에 이 시스템을 등록하면 받는 번호
# SSO_CLIENT_SECRET 포털에 등록하면 받는 비밀값 — 저장소에 적지 마세요
# SSO_REDIRECT_URI  포털이 되돌려 보낼 주소. 포털에 등록한 값과 **글자 그대로**
#                   같아야 합니다. 끝은 /api/sso/callback 입니다.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=

# 값을 지우지 않고 통합 로그인만 잠시 끄고 싶을 때 : SSO=off
SSO=

# AI 기능을 쓸 때만. config.docker.json 의 ai.enabled 도 true 로.
OPENAI_API_KEY=

# PC 의 Docker Desktop 에서 시험할 때만 필요 (compose.dev.yaml 이 공유폴더를 SMB 로 붙일 때 사용)
# 읽기 권한만 있는 NAS 계정을 권장합니다. 비밀번호에 쉼표(,)는 쓸 수 없습니다.
NAS_USER=
NAS_PASS=
