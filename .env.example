# 이 파일을 복사해 .env 로 만들고 값을 채우세요.
#
#   copy .env.example .env      (윈도)
#
# .env 는 저장소에 올라가지 않습니다(.gitignore).
# 도커로 옮긴 뒤에는 이 파일 대신 컨테이너 환경변수(-e)로 넣는 편이 안전합니다.
# 이미 환경변수가 설정돼 있으면 .env 값보다 그쪽이 우선합니다.

# OpenAI API 키. AI 검색을 쓸 때만 필요합니다.
# 값이 비어 있으면 AI 기능은 꺼진 상태로 동작하고, 기존 통합검색은 그대로 됩니다.
OPENAI_API_KEY=

# 팀 공용 비밀번호. 비어 있으면 이 PC(127.0.0.1)에서만 열립니다.
TEAM_PASSWORD=

# ── 통합 로그인(DSS 포털) ───────────────────────────────────────────────────
# 네 값이 모두 채워져야 켜집니다. 자세한 설명은 docker.env.example 에 있습니다.
# 🔴 TEAM_PASSWORD 와 함께 켜 두면 비밀번호만 알아도 들어올 수 있습니다.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=

# 값을 지우지 않고 통합 로그인만 잠시 끄고 싶을 때 : SSO=off
SSO=
